#!/usr/bin/env just --justfile

dart_version := "stable"
out_dir      := "build"
bin_src      := "bin/server.dart"

# ── Local build (current platform) ──────────────────────────────────────────

# Build for the current platform (macOS arm64 / macOS x64 / Linux)
build:
  mkdir -p {{out_dir}}
  dart compile exe {{bin_src}} -o {{out_dir}}/gitlab-webhook-server
  @echo "Built: {{out_dir}}/gitlab-webhook-server"
  fvm dart pub get

# ── Docker builds (cross-platform Linux) ─────────────────────────────────────

# Build Linux amd64 binary via Docker (works on macOS and CI)
build-linux-amd64:
  mkdir -p {{out_dir}}
  docker run --rm --platform linux/amd64 \
    -v "$(pwd)":/app -w /app \
    dart:{{dart_version}} \
    bash -c "dart pub get && dart compile exe {{bin_src}} -o {{out_dir}}/gitlab-webhook-server-linux-amd64"
  @echo "Built: {{out_dir}}/gitlab-webhook-server-linux-amd64"
  fvm dart pub get

# Build Linux arm64 binary via Docker (for ARM servers / Raspberry Pi)
build-linux-arm64:
  mkdir -p {{out_dir}}
  docker run --rm --platform linux/arm64 \
    -v "$(pwd)":/app -w /app \
    dart:{{dart_version}} \
    bash -c "dart pub get && dart compile exe {{bin_src}} -o {{out_dir}}/gitlab-webhook-server-linux-arm64"
  @echo "Built: {{out_dir}}/gitlab-webhook-server-linux-arm64"
  fvm dart pub get

# ── Docker image ─────────────────────────────────────────────────────────────

image_name := "gitlab-webhook-server"
image_tag  := "latest"

# Build a minimal Docker image (scratch + Linux amd64 binary)
docker-image: build-linux-amd64
  docker build \
    --platform linux/amd64 \
    --build-arg BINARY={{out_dir}}/gitlab-webhook-server-linux-amd64 \
    -t {{image_name}}:{{image_tag}} \
    -f Dockerfile .
  @echo "Image: {{image_name}}:{{image_tag}}"

# ── Dev / test ───────────────────────────────────────────────────────────────

# Run server locally (dart run, no compile)
run *args:
  dart run {{bin_src}} {{args}}

# Run tests
test:
  dart test

# Analyze
check:
  dart analyze