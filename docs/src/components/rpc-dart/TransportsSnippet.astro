import { Code } from '@astrojs/starlight/components';

const code = `
import 'package:rpc_dart_transports/rpc_dart_transports.dart';

Future<void> main() async {
  // WebSocket transport (client side)
  final wsTransport = RpcWebSocketCallerTransport.connect(
    Uri.parse('ws://localhost:8080/rpc'),
  );

  // HTTP/2 transport for production APIs
  final httpTransport = await RpcHttp2CallerTransport.secureConnect(
    host: 'api.example.com',
  );

  // In-memory transport for tests or co-located services
  final (clientTransport, serverTransport) = RpcInMemoryTransport.pair();

  final caller = RpcCallerEndpoint(transport: wsTransport);
  final calculator = CalculatorCaller(caller);

  final result = await calculator.add(AddRequest(a: 1, b: 2));
  print('Result: \${result.result}');
}
`;
