import { Code } from '@astrojs/starlight/components';

const code = `
// Сервер стрим - отправляет поток чисел от 1 до N
Stream<NumberData> countTo(CountRequest request) {
  return Stream.fromIterable(
    List.generate(request.count, (i) => NumberData(value: i + 1))
  ).asyncMap((number) async {
    // Имитация задержки
    await Future.delayed(Duration(milliseconds: 100));
    return number;
  });
}

// Использование на клиенте
void main() async {
  final transport = RpcInMemoryTransport();
  final caller = RpcCallerEndpoint(transport: transport);
  final counter = CounterCaller(caller);
  
  // Подписываемся на поток чисел
  await for (final number in counter.countTo(CountRequest(count: 5))) {
    print('Получено число: \${number.value}');
  }
  // Вывод: 1, 2, 3, 4, 5
}
`;
