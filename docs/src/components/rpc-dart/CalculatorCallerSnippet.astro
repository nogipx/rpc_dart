const code = `
// lib/clients/calculator_caller.dart
import 'package:rpc_dart/rpc_dart.dart';
import '../contracts/calculator_contract.dart';

class CalculatorCaller extends RpcCaller implements CalculatorContract {
  CalculatorCaller(RpcCallerEndpoint endpoint) : super(endpoint);

  @override
  String get contractName => 'CalculatorContract';

  @override
  Future<CalculatorResult> add(AddRequest request) async {
    return await call<CalculatorResult>(
      methodName: 'add',
      request: request,
    );
  }

  @override
  Future<CalculatorResult> multiply(MultiplyRequest request) async {
    return await call<CalculatorResult>(
      methodName: 'multiply', 
      request: request,
    );
  }
}
`;
