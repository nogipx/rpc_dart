const code = `
// lib/contracts/calculator_contract.dart
import 'package:rpc_dart/rpc_dart.dart';

// Запросы
class AddRequest {
  final int a;
  final int b;
  
  AddRequest({required this.a, required this.b});
}

class MultiplyRequest {
  final int x;
  final int y;
  
  MultiplyRequest({required this.x, required this.y});
}

// Ответы
class CalculatorResult {
  final int result;
  
  CalculatorResult({required this.result});
}

// Контракт калькулятора
abstract class CalculatorContract {
  Future<CalculatorResult> add(AddRequest request);
  Future<CalculatorResult> multiply(MultiplyRequest request);
}
`;
