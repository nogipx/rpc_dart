---
import { Code } from '@astrojs/starlight/components';

const code = `
// lib/main.dart
import 'package:rpc_dart/rpc_dart.dart';
import 'contracts/calculator_contract.dart';
import 'services/calculator_responder.dart';
import 'clients/calculator_caller.dart';

void main() async {
  // Создание InMemory транспорта
  final transport = RpcInMemoryTransport();
  
  // Настройка сервера (responder)
  final responder = RpcResponderEndpoint(transport: transport);
  responder.registerServiceContract(CalculatorResponder());
  await responder.start();
  
  // Настройка клиента (caller)  
  final caller = RpcCallerEndpoint(transport: transport);
  final calculator = CalculatorCaller(caller);
  
  try {
    // Выполнение RPC вызовов
    final addResult = await calculator.add(AddRequest(a: 10, b: 5));
    print('10 + 5 = \${addResult.result}'); // 15
    
    final multiplyResult = await calculator.multiply(MultiplyRequest(x: 4, y: 7));
    print('4 * 7 = \${multiplyResult.result}'); // 28
    
  } finally {
    await caller.close();
    await responder.close();
  }
}
`;
