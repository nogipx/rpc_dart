## 📡 Stream Distributor - Server Stream Management

**Stream Distributor** provides powerful mechanism for managing server streams with support for multiple subscribers, filtering, and lifecycle management.

### Main Features
- **Broadcast publishing** messages to all clients
- **Filtered publishing** only to specific clients
- **Subscription management** (pause/resume, close)
- **Automatic cleanup** of inactive streams
- **Metrics and monitoring** of stream activity

### Integration with CORD Responder

```dart
final class UserResponder extends RpcResponderContract implements IUserContract {
  // Stream Distributor for managing user events
  final StreamDistributor<UserEvent> _userEventDistributor;
  
  UserResponder({
    required UserRepository userRepository,
  }) : _userRepository = userRepository,
       _userEventDistributor = StreamDistributor<UserEvent>(
         config: StreamDistributorConfig(
           enableAutoCleanup: true,
           cleanupInterval: Duration(minutes: 5),
           inactivityThreshold: Duration(minutes: 30),
         ),
         logger: RpcLogger('UserEventDistributor'),
       ),
       super(IUserContract.name);
  
  @override
  void setup() {
    addServerStreamMethod<UserEventsRequest, UserEvent>(
      methodName: 'SubscribeToUserEvents',
      handler: subscribeToUserEvents,
      requestCodec: UserEventsRequest.codec,
      responseCodec: UserEvent.codec,
    );
    
    // Setup repository change listener
    _setupUserEventListening();
  }
  
  @override
  Stream<UserEvent> subscribeToUserEvents(UserEventsRequest request, {RpcContext? context}) {
    // Create personal stream for client
    final clientId = context?.traceId ?? 'client_${DateTime.now().millisecondsSinceEpoch}';
    
    // Filter events by user and types
    return _userEventDistributor.createClientStreamWithId(
      clientId,
      onCancel: () {
        RpcLogger('UserResponder').info('Client $clientId unsubscribed from events');
      },
    ).where((event) => 
      event.userId == request.userId && 
      request.eventTypes.contains(event.type)
    );
  }
  
  void _setupUserEventListening() {
    // Listen to repository changes and publish events
    _userRepository.watchAllUserEvents().listen((domainEvent) {
      final userEvent = UserEvent.fromDomainEvent(domainEvent);
      
      // Publish to all subscribers
      final deliveredCount = _userEventDistributor.publish(userEvent);
      
      RpcLogger('UserResponder').internal(
        'Published event ${userEvent.type} for user ${userEvent.userId} '
        '(delivered to $deliveredCount clients)',
      );
    });
  }
  
  // Additional methods for subscription management
  Future<void> pauseUserNotifications(String userId) async {
    // Pause notifications for specific user
    final pausedCount = _userEventDistributor.publishFiltered(
      UserEvent.pauseNotifications(userId),
      (client) => client.clientId.contains(userId),
    );
    
    RpcLogger('UserResponder').info('Paused notifications for $userId ($pausedCount clients)');
  }
  
  Future<void> dispose() async {
    await _userEventDistributor.dispose();
  }
}
```

### Advanced Stream Distributor Usage

```dart
// Create distributor with configuration and callbacks
final distributor = StreamDistributor<NotificationEvent>(
  config: StreamDistributorConfig(
    enableAutoCleanup: true,
    cleanupInterval: Duration(minutes: 2),
    inactivityThreshold: Duration(minutes: 10),
    autoRemoveOnCancel: true,
  ),
  logger: RpcLogger('NotificationDistributor'),
  onSubscriptionCreated: (distributorId, subscriberId) {
    // Log new subscriptions with analytics
    RpcLogger('StreamDistributor').info('New subscription: $subscriberId to $distributorId');
    _analyticsService.trackSubscription(subscriberId, distributorId);
  },
  onSubscriptionCancelled: (distributorId, subscriberId) {
    // Log unsubscriptions and cleanup resources
    RpcLogger('StreamDistributor').info('Unsubscription: $subscriberId from $distributorId');
    _analyticsService.trackUnsubscription(subscriberId, distributorId);
    _cleanupUserResources(subscriberId);
  },
);

// Broadcast publishing
final deliveredCount = distributor.publish(
  SystemMaintenanceEvent(
    message: 'Scheduled system maintenance in 10 minutes',
    startTime: DateTime.now().add(Duration(minutes: 10)),
  ),
);

// Filtered publishing only to premium users
distributor.publishFiltered(
  PremiumFeatureUnlockedEvent(feature: 'advanced_analytics'),
  (client) {
    // Check client by ID or other characteristics
    return client.clientId.contains('premium');
  },
);

// Publishing to specific client
distributor.publishToClient(
  'user_12345_stream',
  PersonalizedRecommendationEvent(
    userId: '12345',
    recommendations: ['item1', 'item2', 'item3'],
  ),
);

// Subscription management
distributor.pauseClientStream('user_12345_stream');
await Future.delayed(Duration(seconds: 30));
distributor.resumeClientStream('user_12345_stream');

// Activity monitoring
final metrics = distributor.metrics;
print('Active streams: ${metrics.currentStreams}');
print('Total messages: ${metrics.totalMessages}');
print('Average message size: ${metrics.averageMessageSize} bytes');

// Get client information
final activeClients = distributor.getActiveClientIds();
final inactiveClients = distributor.getInactiveClientIds(Duration(minutes: 5));
final pausedClients = distributor.getPausedClientIds();

print('Active clients: $activeClients');
print('Inactive clients: $inactiveClients');
print('Paused clients: $pausedClients');

// Cleanup inactive connections
final removedCount = await distributor.closeInactiveStreams(Duration(minutes: 15));
print('Removed inactive connections: $removedCount');
```

### Event Sourcing Pattern with Stream Distributor

```dart
final class OrderResponder extends RpcResponderContract implements IOrderContract {
  final StreamDistributor<OrderEvent> _orderEventDistributor;
  final OrderEventStore _eventStore;
  
  OrderResponder({
    required OrderEventStore eventStore,
  }) : _eventStore = eventStore,
       _orderEventDistributor = StreamDistributor<OrderEvent>(),
       super(IOrderContract.name);
  
  @override
  Future<CreateOrderResponse> createOrder(CreateOrderRequest request, {RpcContext? context}) async {
    // Create order
    final order = Order.create(request);
    
    // Save event to Event Store
    final event = OrderCreatedEvent(
      orderId: order.id,
      userId: request.userId,
      items: request.items,
      timestamp: DateTime.now(),
    );
    
    await _eventStore.appendEvent(event);
    
    // Publish event to all interested parties
    _orderEventDistributor.publish(event, metadata: {
      'source': 'order_creation',
      'version': order.version,
    });
    
    return CreateOrderResponse(order: order);
  }
  
  @override
  Stream<OrderEvent> subscribeToOrderEvents(OrderEventsRequest request, {RpcContext? context}) {
    // Create personalized order events stream
    return _orderEventDistributor.createClientStream()
        .where((event) => event.userId == request.userId);
  }
}
